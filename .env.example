# Supabase Database & Storage Configuration
# Accessed ONLY from server-side code using the service role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Authentication & Session Security (Min 32 characters random string for jose JWT signature)
SESSION_SECRET=super-secret-random-key-at-least-32-characters-long-anubhav

# Google Gemini AI Integration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

